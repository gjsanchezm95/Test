                <SQLTask:SqlTaskData
                  SQLTask:Connection="{E716C2B3-CDBE-4FF9-9F74-5C4AFF3B0668}"
                  SQLTask:SqlStatementSource="Select top 1 CAST(T.Flag_Val_Extraction as bit) from &#xA;(SELECT CASE WHEN (SELECT COUNT(*) FROM HCM.DBO.EC_D_Demographic_athire (NOLOCK))=(SELECT COUNT(*) FROM HRStage.dbo.GHRD5003_EXT_athire (NOLOCK) )&#xA;THEN 'TRUE'&#xA;ELSE 'FALSE'&#xA;END AS Flag_Val_Extraction&#xA;UNION&#xA;SELECT CASE WHEN (SELECT COUNT(*) FROM HCM.DBO.EC_D_Demographic_bioinformation (NOLOCK))=(SELECT COUNT(*) FROM HRStage.dbo.GHRD5003_EXT_bioinformation (NOLOCK) )&#xA;THEN 'TRUE'&#xA;ELSE 'FALSE'&#xA;END AS Flag_Val_Extraction&#xA;UNION&#xA;SELECT CASE WHEN (SELECT COUNT(*) FROM HCM.DBO.EC_F_dep_department (NOLOCK))=(SELECT COUNT(*) FROM HRStage.dbo.GHRD5003_EXT_dep_department (NOLOCK) )&#xA;THEN 'TRUE'&#xA;ELSE 'FALSE'&#xA;END AS Flag_Val_Extraction&#xA;UNION&#xA;SELECT CASE WHEN (SELECT COUNT(*) FROM HCM.DBO.EC_D_Demographic_emailinfo (NOLOCK))=(SELECT COUNT(*) FROM HRStage.dbo.GHRD5003_EXT_emailinfo (NOLOCK) )&#xA;THEN 'TRUE'&#xA;ELSE 'FALSE'&#xA;END AS Flag_Val_Extraction&#xA;UNION&#xA;SELECT CASE WHEN (SELECT COUNT(*) FROM HCM.DBO.EC_D_Demographic_globalassignmentinformation (NOLOCK))=(SELECT COUNT(*) FROM HRStage.dbo.GHRD5003_EXT_globalassignmentinformation (NOLOCK) )&#xA;THEN 'TRUE'&#xA;ELSE 'FALSE'&#xA;END AS Flag_Val_Extraction&#xA;UNION&#xA;SELECT CASE WHEN (SELECT COUNT(*) FROM HCM.DBO.EC_D_demographic_jobinformation (NOLOCK))=(SELECT COUNT(*) FROM HRStage.dbo.GHRD5003_EXT_jobinformation (NOLOCK) )&#xA;THEN 'TRUE'&#xA;ELSE 'FALSE'&#xA;END AS Flag_Val_Extraction&#xA;UNION&#xA;SELECT CASE WHEN (SELECT COUNT(*) FROM HCM.DBO.EC_D_Demographic_personalinfo (NOLOCK))=(SELECT COUNT(*) FROM HRStage.dbo.GHRD5003_EXT_personalinfo (NOLOCK) )&#xA;THEN 'TRUE'&#xA;ELSE 'FALSE'&#xA;END AS Flag_Val_Extraction&#xA;UNION&#xA;SELECT CASE WHEN (SELECT COUNT(*) FROM HR_Processing.DBO.HZ_PickList (NOLOCK))=(SELECT COUNT(*) FROM HRStage.dbo.GHRD5003_EXT_HZ_Picklist (NOLOCK) )&#xA;THEN 'TRUE'&#xA;ELSE 'FALSE'&#xA;END AS Flag_Val_Extraction&#xA;UNION&#xA;SELECT CASE WHEN (SELECT COUNT(*) FROM HCM.DBO.Staging_T12 (NOLOCK))=(SELECT COUNT(*) FROM HRStage.dbo.GHRD5003_EXT_Staging_T12 (NOLOCK) )&#xA;THEN 'TRUE'&#xA;ELSE 'FALSE'&#xA;END AS Flag_Val_Extraction&#xA;UNION&#xA;SELECT CASE WHEN (SELECT COUNT(*) FROM HCM.DBO.EC_F_pos_pos (NOLOCK))=(SELECT COUNT(*) FROM HRStage.dbo.GHRD5003_EXT_pos_pos (NOLOCK) )&#xA;THEN 'TRUE'&#xA;ELSE 'FALSE'&#xA;END AS Flag_Val_Extraction&#xA;UNION&#xA;SELECT CASE WHEN (SELECT COUNT(*) FROM HCM.DBO.EC_F_loc_location (NOLOCK))=(SELECT COUNT(*) FROM HRStage.dbo.GHRD5003_EXT_loc_location (NOLOCK) )&#xA;THEN 'TRUE'&#xA;ELSE 'FALSE'&#xA;END AS Flag_Val_Extraction&#xA;UNION&#xA;SELECT CASE WHEN (SELECT COUNT(*) FROM HR_Processing.HRA.WEB_ISO_MAPPINGS (NOLOCK))=(SELECT COUNT(*) FROM HRStage.dbo.GHRD5003_EXT_WEB_ISO_MAPPINGS (NOLOCK) )&#xA;THEN 'TRUE'&#xA;ELSE 'FALSE'&#xA;END AS Flag_Val_Extraction&#xA;UNION&#xA;SELECT CASE WHEN (SELECT COUNT(*) FROM HCM.DBO.EC_F_employeetime_employeetime (NOLOCK))=(SELECT COUNT(*) FROM HRStage.dbo.GHRD5003_EXT_employeetime_employeetime (NOLOCK) )&#xA;THEN 'TRUE'&#xA;ELSE 'FALSE'&#xA;END AS Flag_Val_Extraction&#xA;) T&#xA;order by T.Flag_Val_Extraction"
                  SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
                  <SQLTask:ResultBinding
                    SQLTask:ResultName="0"
                    SQLTask:DtsVariableName="User::Flag_Val_Extraction" />
                </SQLTask:SqlTaskData>
