                    <DTS:Executable
                      DTS:refId="Package\SC_RUN_PACKAGE\SC_TRANSFORMATION_PHASE\FL_TRANSFORMATION_LOAD_PHASE\SC_TRANSFORMATION_LOAD\MainQuery"
                      DTS:CreationName="Microsoft.ExecuteSQLTask"
                      DTS:Description="Execute SQL Task"
                      DTS:DTSID="{342bd538-99d2-4961-922d-0dbf83438705}"
                      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
                      DTS:LocaleID="-1"
                      DTS:ObjectName="MainQuery"
                      DTS:ThreadHint="0">
                      <DTS:Variables />
                      <DTS:ObjectData>
                        <SQLTask:SqlTaskData
                          SQLTask:Connection="{E716C2B3-CDBE-4FF9-9F74-5C4AFF3B0668}"
                          SQLTask:SqlStatementSource="TRUNCATE TABLE [HRStage].[dbo].[GHRD5003_EXT_MAINQUERY];&#xA;&#xA;select &#xA;Internal_id,Min(effective_start_date) as Min_Start_date&#xA;into #FIRSTHIRE&#xA;FROM [HRStage].[dbo].[GHRD5003_EXT_jobinformation] (NOLOCK)&#xA;group by internal_id&#xA;&#xA;&#xA;Select &#xA; DJOBRH.internal_id&#xA;,DJOBRH.event_reason as DJOBRHL_event_reason&#xA;,DJOBRH.effective_start_date as DJOBRH_effective_start_date&#xA;,DJOBRH.effective_end_date as DJOBRH_effective_end_date&#xA;,DJOBRH.emplstatus as DJOBRH_emlstatus&#xA;,DJOBRH.employee_type as DJOBRH_employee_type&#xA;into #GHRD5003_RH&#xA;from [HRStage].[dbo].[GHRD5003_EXT_jobinformation] (NOLOCK) DJOBRH&#xA;WHERE DJOBRH.internal_id = DJOBRH.userid&#xA;AND DJOBRH.event_reason like 'RH_%'&#xA;AND DJOBRH.effective_start_date &lt;= CAST(GETDATE() AS DATE)&#xA;&#xA;select&#xA;PPE.*&#xA;,DJOBL.event_reason as DJOBL_event_reason&#xA;,DJOBL.effective_start_date as DJOBL_effective_start_date&#xA;,DJOBL.effective_end_date as DJOBL_effective_end_date&#xA;,DJOBL.emplstatus as DJOBL_emlstatus&#xA;,DJOBL.employee_type as DJOBL_employee_type&#xA;into #GHRD5003_RH_T_Status&#xA;from #GHRD5003_RH PPE&#xA;LEFT JOIN [HRStage].[dbo].[GHRD5003_EXT_jobinformation] (NOLOCK) DJOBL&#xA;ON PPE.internal_id = DJOBL.internal_id&#xA;AND DJOBL.internal_id = DJOBL.userid&#xA;AND DJOBL.event_reason like 'T_%'&#xA;AND DJOBL.effective_start_date &lt;= PPE.DJOBRH_effective_start_date&#xA;AND NOT EXISTS (select 1 from HRSTAGE.[dbo].GHRD5003_EXT_jobinformation (NOLOCK) DJOBL_1&#xA;&#x9;&#x9;&#x9;&#x9;WHERE DJOBL.internal_id = DJOBL_1.internal_id&#xA;&#x9;&#x9;&#x9;&#x9;AND DJOBL_1.internal_id = DJOBL_1.userid&#xA;&#x9;&#x9;&#x9;&#x9;AND DJOBL_1.event_reason like 'T_%'&#xA;&#x9;&#x9;&#x9;&#x9;AND DJOBL_1.effective_start_date &lt;= PPE.DJOBRH_effective_start_date&#xA;&#x9;&#x9;&#x9;&#x9;AND DJOBL_1.effective_start_date &gt; DJOBL.effective_start_date&#xA;&#x9;&#x9;&#x9;&#x9;)&#xA;&#xA;Select &#xA; distinct&#xA; PPE.internal_id&#xA;,MAX(PPE.DJOBRH_effective_start_date) as RH_effective_start_date&#xA;into #GHRD5003_BRK_Services&#xA;from #GHRD5003_RH_T_Status PPE&#xA;where CASE   &#xA;&#x9;&#x9;WHEN PPE.DJOBL_effective_start_date is not null AND PPE.DJOBRH_effective_start_date is not null --AND DJOBL_employee_type not in ('student','intern') &#xA;&#x9;&#x9;AND DATEDIFF(DAY,DJOBL_effective_start_date,DJOBRH_effective_start_date) &gt; 5 &#xA;&#x9;&#x9;THEN 1&#xA;&#x9;&#x9;WHEN PPE.DJOBL_effective_start_date is not null AND PPE.DJOBRH_effective_start_date is not null AND (DJOBRH_employee_type = 'casual' or DJOBL_employee_type = 'casual' ) THEN 1&#xA;&#x9;&#x9;  -- WHEN PPE.DJOBL_effective_start_date is null AND PPE.DJOBRH_effective_start_date is not null THEN 0&#xA;&#x9;&#x9;   ELSE 0&#xA;&#x9;&#x9;END = 1&#xA;group by PPE.internal_id&#xA;&#xA;select &#xA; DAH.internal_id&#xA;,CASE --WHEN BRKS.internal_id is null AND DAH.service_date &lt;= DAH.original_start_date AND DAH.service_date &lt;= '2019-02-04' THEN ISNULL(DAH.service_date,DAH.original_start_date) &#xA;&#x9;  WHEN BRKS.internal_id is null AND FH.Min_Start_date &gt; '2019-02-04' THEN ISNULL(FH.Min_Start_date,DAH.service_date) &#xA;&#x9;  WHEN BRKS.internal_id is null AND DAH.start_date &gt; '2019-02-04' AND DAH.original_start_date &lt;= DAH.start_date THEN ISNULL(DAH.original_start_date,DAH.service_date) &#xA;&#x9;--  WHEN BRKS.internal_id is null AND DAH.start_date &lt; '2019-02-04' AND DAH.original_start_date &lt;= DAH.start_date THEN ISNULL(DAH.start_date,DAH.service_date) &#xA;&#x9;  WHEN BRKS.internal_id is null AND DAH.original_start_date = DAH.start_date THEN ISNULL(DAH.original_start_date,DAH.start_date) &#xA;&#x9;--  WHEN BRKS.internal_id is null AND DAH.original_start_date &lt;&gt; DAH.start_date AND DAH.original_start_date &gt; '2019-02-04' THEN ISNULL(DAH.original_start_date,DAH.start_date)&#xA;&#x9;  WHEN BRKS.internal_id is null AND DAH.original_start_date &lt;&gt; DAH.start_date THEN ISNULL(DAH.start_date,DAH.original_start_date) &#xA;&#x9;  WHEN BRKS.internal_id is not null AND BRKS.RH_Effective_start_date &lt; DAH.start_date THEN ISNULL(BRKS.RH_Effective_start_date,DAH.start_date) &#xA;&#x9;  ELSE ISNULL(DAH.start_date,DAH.original_start_date) &#xA;  END as DAH_HIRE_DATE&#xA;--,DAH.service_date as DAH_HIRE_DATE&#xA;into #GHRD5003_EXT_HIRE_DATE&#xA;FROM HRStage.[dbo].[GHRD5003_EXT_athire] DAH(NOLOCK)&#xA;LEFT JOIN #GHRD5003_BRK_Services BRKS&#xA;ON DAH.internal_id  = BRKS.internal_id&#xA;LEFT JOIN #FIRSTHIRE FH&#xA;ON FH.internal_id = DAH.internal_id&#xA;where DAH.Start_date &lt;= CAST(GETDATE() as DATE)&#xA;AND DAH.internal_id = DAH.UserId&#xA;AND not exists (select 1 from HRStage.dbo.[GHRD5003_EXT_athire] B where DAH.Internal_id = B.Internal_id and B.start_date &gt; DAH.start_date  AND B.Start_date &lt;= CAST(GETDATE() as DATE) AND B.internal_id = B.UserId)&#xA;&#xA;&#xA;SELECT DISTINCT T.internal_id,T.emplStatus,T.event_reason &#xA;into #GHRD5003_CA_EXT_jobinformation_eventreasonLV&#xA;FROM(&#xA;select ROW_NUMBER()OVER(PARTITION BY DJOB.internal_id ORDER BY DJOB.effective_start_date DESC) AS RN,&#xA;DJOB.internal_id,DJOB.emplStatus,DJOB.effective_start_date,DJOB.effective_end_date,DJOB.event_reason&#xA;from     [HRStage].[dbo].[GHRD5003_EXT_jobinformation] (NOLOCK) DJOB&#xA;where DJOB.event_reason like 'LV%'&#xA;and DJOB.effective_start_date &lt;= CAST(GETDATE() as DATE)&#xA;)T&#xA;WHERE T.RN=1&#xA;AND T.emplStatus in ('P','U')&#xA;&#xA;select&#xA; CASE WHEN LEN(AutoStructure_01) &lt;= 0 AND Department_Code &lt;&gt; 'OU00001' THEN NULL ELSE AutoStructure_01 END AutoStructure_01&#xA;,CASE WHEN LEN(AutoStructure_02) &lt;= 0 AND Department_Code &lt;&gt; 'OU00001' THEN NULL ELSE AutoStructure_02 END AutoStructure_02&#xA;,CASE WHEN LEN(AutoStructure_03) &lt;= 0 AND Department_Code &lt;&gt; 'OU00001' THEN NULL ELSE AutoStructure_03 END AutoStructure_03&#xA;,CASE WHEN LEN(AutoStructure_04) &lt;= 0 AND Department_Code &lt;&gt; 'OU00001' THEN NULL ELSE AutoStructure_04 END AutoStructure_04&#xA;,CASE WHEN LEN(AutoStructure_05) &lt;= 0 AND Department_Code &lt;&gt; 'OU00001' THEN NULL ELSE AutoStructure_05 END AutoStructure_05&#xA;,CASE WHEN LEN(AutoStructure_06) &lt;= 0 AND Department_Code &lt;&gt; 'OU00001' THEN NULL ELSE AutoStructure_06 END AutoStructure_06&#xA;,CASE WHEN LEN(AutoStructure_07) &lt;= 0 AND Department_Code &lt;&gt; 'OU00001' THEN NULL ELSE AutoStructure_07 END AutoStructure_07&#xA;,Department_Code&#xA;INTO #GHRD5003_EXT_Staging_T12_NULL&#xA;from&#xA;[HRStage].[dbo].[GHRD5003_EXT_Staging_T12]&#xA;&#xA;UPDATE #GHRD5003_EXT_Staging_T12_NULL&#xA;SET &#xA; AutoStructure_01 = 'Scotiabank Other'&#xA;,AutoStructure_02 = 'Scotiabank Other'&#xA;,AutoStructure_03 = 'Scotiabank Other'&#xA;,AutoStructure_04 = 'Scotiabank Other'&#xA;,AutoStructure_05 = 'Scotiabank Other'&#xA;,AutoStructure_06 = 'Scotiabank Other'&#xA;,AutoStructure_07 = 'Scotiabank Other'&#xA;where Department_Code = 'OU00001'&#xA;&#xA;select&#xA; AutoStructure_01&#xA;,COALESCE(AutoStructure_02,AutoStructure_01) as AutoStructure_02&#xA;,COALESCE(AutoStructure_03,AutoStructure_02,AutoStructure_01) as AutoStructure_03&#xA;,COALESCE(AutoStructure_04,AutoStructure_03,AutoStructure_02,AutoStructure_01) as AutoStructure_04&#xA;,COALESCE(AutoStructure_05,AutoStructure_04,AutoStructure_03,AutoStructure_02,AutoStructure_01) as AutoStructure_05&#xA;,COALESCE(AutoStructure_06,AutoStructure_05,AutoStructure_04,AutoStructure_03,AutoStructure_02,AutoStructure_01) as AutoStructure_06&#xA;,COALESCE(AutoStructure_07,AutoStructure_06,AutoStructure_05,AutoStructure_04,AutoStructure_03,AutoStructure_02,AutoStructure_01) as AutoStructure_07&#xA;,Department_Code&#xA;INTO #GHRD5003_EXT_Staging_T12_FINAL&#xA;from #GHRD5003_EXT_Staging_T12_NULL&#xA;ORDER BY Department_Code&#xA;&#xA;INSERT INTO [HRStage].[dbo].[GHRD5003_EXT_MAINQUERY]&#xA;select&#xA; distinct&#xA;DBIO.Employee_ID as employeeid&#xA;,DBIO.scotia_id as scotia_id&#xA;,DEADD.email_address as emailAddr&#xA;,DPER.First_Name as firstname&#xA;,DPER.Last_Name as lastName&#xA;,'' AS LoginID&#xA;,'' AS Password&#xA;,DBIO_MANG.scotia_id as Managerid&#xA;,DPER.native_preferred_lang as lang&#xA;,FBADD.Location_Code&#xA;--,webmapp.ISO_CODE AS CountryISO&#xA;,CAST(HZPL.HZColValue as CHAR(15)) as CountryISO&#xA;,DJOB.job_level AS jobgrade&#xA;,HZPL.ECColValue AS poscountrylong&#xA;,ISNULL(DPER.preferred_name,NULL) AS preferredfirstname&#xA;,substring(DJOB.cost_center,1,5) AS transit&#xA;,CASE&#xA;       WHEN DJOB.emplStatus NOT IN ('P', 'U') AND DJOB.employee_type IN ('Regular','Contract','Casual') THEN 'STANDARD'&#xA;       WHEN DJOB.emplStatus NOT IN ('P', 'U') AND DJOB.employee_type IN ('Intern','Student') THEN 'STUDENT' &#xA;&#xA;       WHEN DJOB.emplStatus IN ('P', 'U') AND TEMPER.event_reason IN ('LV_1005','LV_1004','LV_1051','LV_1006','LV_1033') AND FET.userid IS NULL THEN 'NULLLeave'&#xA;       WHEN DJOB.emplStatus IN ('P', 'U') AND TEMPER.event_reason IN ('LV_1005','LV_1004','LV_1051','LV_1006','LV_1033') AND FET.cust_OriginalDateOfDisability IS NULL THEN 'OrgLEAVE'      &#xA;&#xA;              WHEN DJOB.emplStatus IN ('P', 'U') AND TEMPER.event_reason IN ('LV_1005','LV_1004','LV_1051','LV_1006','LV_1033') AND DATEDIFF(DAY,FET.cust_OriginalDateOfDisability,GETDATE()) &lt;= 730  THEN 'LTI'&#xA;              WHEN DJOB.emplStatus IN ('P', 'U') AND TEMPER.event_reason IN ('LV_1005','LV_1004','LV_1051','LV_1006','LV_1033') AND DATEDIFF(DAY,FET.cust_OriginalDateOfDisability,GETDATE()) &gt; 730  THEN 'Exclude'&#xA;              WHEN DJOB.emplStatus IN ('P', 'U') AND TEMPER.event_reason IN ('LV_1017' ,'LV_1018' ,'LV_1043') THEN 'STANDARD'&#xA;              WHEN DJOB.emplStatus IN ('P', 'U') AND TEMPER.event_reason NOT IN ('LV_1017' ,'LV_1018' ,'LV_1043','LV_1006','LV_1005','LV_1004','LV_1051','LV_1033') THEN 'LEAVE'&#xA;              ELSE ''&#xA;END AS emplymentstatus&#xA;,CONCAT((CASE WHEN DJOB.is_fulltime_employee = '1' THEN 'FT-' ELSE  'PT-' END), DJOB.employee_type) AS employmentclassification&#xA;,FPOS.[Position_Title_en_US] as positiontitle&#xA;,STG12.AutoStructure_01 as Businessunit&#xA;,FDEP.Department_Name_en_US AS Department&#xA;,'' as VP&#xA;,STG12.AutoStructure_02 AS Fileterdivision&#xA;,STG12.AutoStructure_03 AS FilterLevel3&#xA;,STG12.AutoStructure_04 AS FilterLevel4&#xA;,STG12.AutoStructure_05 AS FilterLevel5&#xA;,DJOB.job_code AS jobcode&#xA;,CASE WHEN (TC.tcemployeeid is not null)&#xA;         THEN&#xA;                     CASE&#xA;                           WHEN (day(TC.tcservicedate) = 29 AND MONTH(TC.tcservicedate) = 02) then Convert(nvarchar,dateadd(day,-1,TC.tcservicedate) ,101)&#xA;                           ELSE TC.tcservicedate&#xA;                     END&#xA;         ELSE&#xA;                     CASE&#xA;                           WHEN (day(HD.DAH_HIRE_DATE) = 29 AND MONTH(HD.DAH_HIRE_DATE) = 02) then CONVERT(nvarchar,dateadd(day,-1,HD.DAH_HIRE_DATE), 101)&#xA;                           ELSE HD.DAH_HIRE_DATE&#xA;                     END&#xA;       END AS Hiredate&#xA;,CONCAT(DPER_MANG.first_name, ' ', DPER_MANG.Last_name) AS managername&#xA;,DBIO_MANG_MANG.Scotia_id AS mgrmanagerid&#xA;,CASE WHEN DJOB.executive_level in ('EVP','GH','PCEO','SVP','VP') THEN DJOB.executive_level&#xA;         ELSE '' &#xA; END AS executiveflag&#xA;,'' AS Allreports&#xA;,'' AS Directreports&#xA;,'' AS SVP&#xA;,DJOB.internal_id&#xA;,DJOB.userid&#xA;,CAST(GETDATE() as DATE) as Date_loaded&#xA;FROM [HRStage].[dbo].[GHRD5003_EXT_bioinformation] (NOLOCK) DBIO&#xA;LEFT JOIN [HRStage].[dbo].[GHRD5003_EXT_emailinfo] (NOLOCK) DEADD&#xA;ON DEADD.Internal_id = DBIO.internal_id&#xA;AND DEADD.email_type = 'B'&#xA;LEFT JOIN [HRStage].[dbo].[GHRD5003_EXT_personalinfo] (NOLOCK) DPER&#xA;ON DPER.internal_id = DBIO.internal_id&#xA;AND DPER.Effective_start_date &lt;= CAST(GETDATE() as DATE)&#xA;AND DPER.Effective_end_date &gt;= CAST(GETDATE() as DATE)&#xA;LEFT JOIN [HRStage].[dbo].[GHRD5003_EXT_jobinformation] (NOLOCK) DJOB&#xA;ON DJOB.internal_id = DBIO.internal_id&#xA;AND DJOB.Effective_start_date &lt;= CAST(GETDATE() as DATE)&#xA;AND DJOB.Effective_end_date &gt;= CAST(GETDATE() as DATE)&#xA;AND NOT EXISTS (select 1 from [HRStage].[dbo].[GHRD5003_EXT_jobinformation]  (NOLOCK) DJOB2 &#xA;                           where DJOB.internal_id = DJOB2.internal_id&#xA;                           AND DJOB.userid = DJOB2.UserId&#xA;                           AND DJOB2.emplStatus NOT IN (select parameterValue from HR_Processing.DBO.GHRD5003_Parameters where parameterName = 'emplStatus')&#xA;                           AND DJOB2.Effective_start_date &lt;= CAST(GETDATE() as DATE)&#xA;                           AND DJOB2.Effective_end_date &gt;= CAST(GETDATE() as DATE)&#xA;                           AND DJOB2.Effective_start_date &lt; DJOB.Effective_start_date)&#xA;LEFT JOIN [HRStage].[dbo].[GHRD5003_EXT_jobinformation] (NOLOCK) DJOB_MANG&#xA;ON DJOB_MANG.userid = DJOB.manager_id&#xA;--AND ISNULL(DJOB_MANG.manager_id,'NO_MANAGER') &lt;&gt; 'NO_MANAGER'&#xA;AND DJOB_MANG.Effective_start_date &lt;= CAST(GETDATE() as DATE)&#xA;AND DJOB_MANG.Effective_end_date &gt;= CAST(GETDATE() as DATE)&#xA;AND NOT EXISTS (select 1 from [HRStage].[dbo].[GHRD5003_EXT_jobinformation]  (NOLOCK) DJOB_MANG2 &#xA;                           where DJOB_MANG.userid = DJOB_MANG2.userid&#xA;                           AND DJOB_MANG2.Effective_start_date &lt;= CAST(GETDATE() as DATE)&#xA;                           AND DJOB_MANG2.Effective_end_date &gt;= CAST(GETDATE() as DATE)&#xA;                           AND DJOB_MANG2.Effective_start_date &lt; DJOB_MANG.Effective_start_date)&#xA;LEFT JOIN [HRStage].[dbo].[GHRD5003_EXT_bioinformation] (NOLOCK) DBIO_MANG&#xA;ON DBIO_MANG.internal_id = DJOB_MANG.internal_id&#xA;LEFT JOIN [HRStage].[dbo].[GHRD5003_EXT_personalinfo] (NOLOCK) DPER_MANG&#xA;ON DPER_MANG.internal_id = DJOB_MANG.internal_id&#xA;AND DPER_MANG.Effective_start_date &lt;= CAST(GETDATE() as DATE)&#xA;AND DPER_MANG.Effective_end_date &gt;= CAST(GETDATE() as DATE)&#xA;LEFT JOIN [HRStage].[dbo].[GHRD5003_EXT_jobinformation] (NOLOCK) DJOB_MANG_MANG&#xA;ON DJOB_MANG_MANG.userid = DJOB_MANG.manager_id&#xA;AND DJOB_MANG_MANG.Effective_start_date &lt;= CAST(GETDATE() as DATE)&#xA;AND DJOB_MANG_MANG.Effective_end_date &gt;= CAST(GETDATE() as DATE)&#xA;AND NOT EXISTS (select 1 from [HRStage].[dbo].[GHRD5003_EXT_jobinformation]  (NOLOCK) DJOB_MANG_MANG2 &#xA;                           where DJOB_MANG_MANG.userid = DJOB_MANG_MANG2.userid&#xA;                           AND DJOB_MANG_MANG2.Effective_start_date &lt;= CAST(GETDATE() as DATE)&#xA;                           AND DJOB_MANG_MANG2.Effective_end_date &gt;= CAST(GETDATE() as DATE)&#xA;                           AND DJOB_MANG_MANG2.Effective_start_date &lt; DJOB_MANG_MANG.Effective_start_date)&#xA;LEFT JOIN [HRStage].[dbo].[GHRD5003_EXT_bioinformation] (NOLOCK) DBIO_MANG_MANG&#xA;ON DBIO_MANG_MANG.internal_id = DJOB_MANG_MANG.internal_id&#xA;LEFT JOIN [HRStage].[dbo].[GHRD5003_EXT_busaddr_busaddress]  (NOLOCK) FBADD&#xA;ON FBADD.Location_Code = DJOB.Location&#xA;AND NOT EXISTS (select 1 from [HRStage].[dbo].[GHRD5003_EXT_busaddr_busaddress]  (NOLOCK) FBADD2 &#xA;                           where FBADD.Location_Code = FBADD2.Location_Code&#xA;                           AND FBADD2.start_date &gt; FBADD.start_date)&#xA;LEFT JOIN [HRStage].[dbo].[GHRD5003_EXT_loc_location] (NOLOCK) FLOC&#xA;ON FLOC.Location_Code = DJOB.Location&#xA;AND NOT EXISTS (select 1 from [HRStage].[dbo].[GHRD5003_EXT_loc_location]  (NOLOCK) FLOC2 &#xA;                           where FLOC.Location_Code = FLOC2.Location_Code&#xA;                           AND FLOC2.start_date &gt; FLOC.start_date)&#xA;LEFT JOIN [HRStage].[dbo].[GHRD5003_EXT_HZ_Picklist] (NOLOCK) HZPL&#xA;ON HZPL.ECColCode = FLOC.Country&#xA;and HZPL.HZReference = 'ISO.MAP'&#xA;and NOT HZPL.ecpicklist = 'currency'&#xA;LEFT JOIN [HRStage].[dbo].[GHRD5003_EXT_employeetime_employeetime] (NOLOCK) FET&#xA;on FET.userid = DJOB.userid&#xA;AND FET.startdate&lt;=DJOB.effective_start_date&#xA;AND ISNULL(FET.loaActualReturnDate,FET.enddate) &gt; DJOB.effective_start_date&#xA;AND FET.approvalstatus = 'APPROVED'&#xA;LEFT JOIN [HRStage].[dbo].[GHRD5003_EXT_pos_pos] (NOLOCK) FPOS&#xA;ON FPOS.Position_Code = DJOB.position&#xA;AND NOT EXISTS (select 1 from [HRStage].[dbo].[GHRD5003_EXT_pos_pos] (NOLOCK) FPOS2 &#xA;                           where FPOS.Position_Code = FPOS2.Position_Code&#xA;                           AND FPOS2.start_date &gt; FPOS.start_date)&#xA;LEFT JOIN #GHRD5003_EXT_Staging_T12_FINAL (NOLOCK) STG12&#xA;ON DJOB.department = STG12.Department_Code&#xA;LEFT JOIN [HRStage].[dbo].[GHRD5003_EXT_dep_department] (NOLOCK) FDEP&#xA;ON FDEP.Department_Code = DJOB.department&#xA;AND NOT EXISTS (select 1 from [HRStage].[dbo].[GHRD5003_EXT_dep_department] (NOLOCK) FDEP2 &#xA;                           where FDEP.Department_Code = FDEP2.Department_Code&#xA;                           AND FDEP2.start_date &gt; FDEP.start_date)&#xA;LEFT JOIN [HRStage].[dbo].[GHRD5003_EXT_athire]  (NOLOCK) DAH&#xA;ON DAH.Internal_id = DJOB.Internal_id&#xA;AND DAH.userid = DAH.Internal_id&#xA;LEFT JOIN&#xA;(&#xA;       select RIGHT(Empnum,len(Empnum)-2) as tcemployeeid,CONVERT( nvarchar, CAST( CAST(Service_Date_Override AS char(8)) AS date), 101) as tcservicedate&#xA;       from [HRStage].[dbo].[GHRD5003_EXT_TributesCntrl] (NOLOCK)   &#xA;) TC &#xA;ON TC.tcemployeeid = DBIO.employee_id&#xA;LEFT JOIN [HRStage].[dbo].[GHRD5003_EXT_globalassignmentinformation] (NOLOCK) DGASS&#xA;ON DJOB.Internal_id = DGASS.Internal_id&#xA;AND DJOB.UserId = DGASS.UserId&#xA;and DGASS.start_date &lt;= CAST(GETDATE() as DATE)&#xA;AND COALESCE(DGASS.end_date, DGASS.planned_end_date, '9999-12-31') &gt;= CAST(GETDATE() as DATE)&#xA;LEFT JOIN #GHRD5003_CA_EXT_jobinformation_eventreasonLV TEMPER&#xA;ON TEMPER.internal_id = DJOB.Internal_id&#xA;LEFT JOIN #GHRD5003_EXT_HIRE_DATE HD&#xA;ON HD.internal_id = DBIO.internal_id&#xA;WHERE&#xA;DJOB.emplStatus NOT IN  (select parameterValue from HR_Processing.DBO.GHRD5003_Parameters where parameterName = 'emplStatus')&#xA;AND substring(DJOB.cost_center,1,5) NOT IN (select parameterValue from HR_Processing.DBO.GHRD5003_Parameters where parameterName = 'cost_center')&#xA;AND DJOB.employee_type IN (select parameterValue from HR_Processing.DBO.GHRD5003_Parameters where parameterName = 'employee_type')&#xA;AND DJOB.job_code NOT IN (select parameterValue from HR_Processing.DBO.GHRD5003_Parameters where parameterName = 'job_code')&#xA;AND&#xA;CASE WHEN DJOB.Internal_id &lt;&gt; DJOB.UserId AND DGASS.Internal_id IS NOT NULL THEN 1&#xA;       WHEN DJOB.Internal_id = DJOB.UserId AND DGASS.Internal_id IS NULL THEN 1&#xA;       ELSE 0&#xA;END = 1;&#xA;&#xA;DELETE from [HRStage].[dbo].[GHRD5003_EXT_MAINQUERY]&#xA;where employeeid&#xA;in&#xA;(&#xA;select employeeid from [HRStage].[dbo].[GHRD5003_EXT_MAINQUERY]&#xA;group by employeeid&#xA;having count(1) &gt; 1&#xA;)&#xA;AND internal_id &lt;&gt; userid;&#xA;&#xA;DROP table #GHRD5003_CA_EXT_jobinformation_eventreasonLV&#xA;DROP table #GHRD5003_EXT_Staging_T12_NULL&#xA;DROP table #GHRD5003_EXT_Staging_T12_FINAL&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
                      </DTS:ObjectData>
                    </DTS:Executable>
                    <DTS:Executable
                      DTS:refId="Package\SC_RUN_PACKAGE\SC_TRANSFORMATION_PHASE\FL_TRANSFORMATION_LOAD_PHASE\SC_TRANSFORMATION_LOAD\VP_SVP"
                      DTS:CreationName="Microsoft.ExecuteSQLTask"
                      DTS:Description="Execute SQL Task"
                      DTS:DTSID="{CFEE57CA-AA76-4FD1-BE24-A6498A5E4550}"
                      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
                      DTS:LocaleID="-1"
                      DTS:ObjectName="VP_SVP"
                      DTS:ThreadHint="0">
                      <DTS:Variables />
                      <DTS:ObjectData>
                        <SQLTask:SqlTaskData
                          SQLTask:Connection="{5E39721A-D791-4A6B-A333-E3322996906F}"
                          SQLTask:SqlStatementSource="DECLARE @COUNT Int&#xA;DECLARE @MAXDATE as DATE&#xA;set @COUNT = 1&#xA;&#xA;select @MAXDATE = MAX(Date_Loaded) FROM HR_PROCESSING.[dbo].[GHRD5003_AchieversOutput]&#xA;&#xA;select&#xA; B.internal_id&#xA;,DJOB.userid&#xA;,A.employeeid&#xA;,DJOB.emplStatus&#xA;,A.EmployeeStatus&#xA;,CAST(round(CASE WHEN ISNUMERIC(DJOB.job_level) = 1 THEN DJOB.job_level ELSE '0' END,0)as int) as JobLevel&#xA;,DJOB.Manager_id as internal_id_VP&#xA;,DJOB.Manager_id as internal_id_SVP&#xA;, 0 as PROCESSED_VP&#xA;,0 as PROCESSED_SVP&#xA;INTO #EMPLOYEES&#xA;from HR_PROCESSING.[dbo].[GHRD5003_AchieversOutput] A&#xA;INNER JOIN [HRStage].[dbo].[GHRD5003_EXT_bioinformation] B&#xA;ON B.employee_id = A.employeeid&#xA;LEFT JOIN [HRStage].[dbo].[GHRD5003_EXT_jobinformation] (NOLOCK) DJOB&#xA;ON DJOB.internal_id = B.internal_id&#xA;AND DJOB.emplStatus NOT IN (select parameterValue from HR_Processing.DBO.GHRD5003_Parameters where parameterName = 'emplStatus')&#xA;AND substring(DJOB.cost_center,1,5) NOT IN (select parameterValue from HR_Processing.DBO.GHRD5003_Parameters where parameterName = 'cost_center')&#xA;AND DJOB.employee_type IN (select parameterValue from HR_Processing.DBO.GHRD5003_Parameters where parameterName = 'employee_type')&#xA;AND DJOB.job_code NOT IN (select parameterValue from HR_Processing.DBO.GHRD5003_Parameters where parameterName = 'job_code')&#xA;AND DJOB.Effective_start_date &lt;= CAST(GETDATE() as DATE)&#xA;AND DJOB.Effective_end_date &gt;= CAST(GETDATE() as DATE)&#xA;AND NOT EXISTS (select 1 from [HRStage].[dbo].[GHRD5003_EXT_jobinformation]  (NOLOCK) DJOB2 &#xA;                           where DJOB.internal_id = DJOB2.internal_id&#xA;                           AND DJOB2.emplStatus  NOT IN (select parameterValue from HR_Processing.DBO.GHRD5003_Parameters where parameterName = 'emplStatus')&#xA;                           AND substring(DJOB2.cost_center,1,5) NOT IN (select parameterValue from HR_Processing.DBO.GHRD5003_Parameters where parameterName = 'cost_center')&#xA;                           AND DJOB2.employee_type IN (select parameterValue from HR_Processing.DBO.GHRD5003_Parameters where parameterName = 'employee_type')&#xA;                           AND DJOB.job_code NOT IN (select parameterValue from HR_Processing.DBO.GHRD5003_Parameters where parameterName = 'job_code')&#xA;                           AND DJOB2.Effective_start_date &lt;= CAST(GETDATE() as DATE)&#xA;                           AND DJOB2.Effective_end_date &gt;= CAST(GETDATE() as DATE)&#xA;                           AND DJOB2.Effective_start_date &lt; DJOB.Effective_start_date)&#xA;where A.Date_Loaded = @MAXDATE &#xA;&#xA;delete from #EMPLOYEES&#xA;where internal_id &lt;&gt; userid&#xA;and internal_id&#xA;in&#xA;(&#xA;select internal_id from #EMPLOYEES&#xA;group by internal_id&#xA;having count(1) &gt; 1&#xA;) &#xA;&#xA;--UPDATE #EMPLOYEES&#xA;--SET PROCESSED_VP = 1&#xA;--WHERE JobLevel &gt;= 10 &#xA;&#xA;--UPDATE #EMPLOYEES&#xA;--SET PROCESSED_SVP = 1&#xA;--WHERE JobLevel &gt;= 11 &#xA;&#xA;UPDATE #EMPLOYEES&#xA;SET&#xA; internal_id_VP = internal_id&#xA;,internal_id_SVP = internal_id&#xA;,PROCESSED_VP = 1&#xA;,PROCESSED_SVP = 1&#xA;WHERE JobLevel = 16&#xA;&#xA;UPDATE #EMPLOYEES&#xA;SET internal_id_VP = 'leave'&#xA;,PROCESSED_VP = 1&#xA;WHERE EmployeeStatus IN ('LTI','leave') and ISNULL(internal_id_VP,'NO_MANAGER') = 'NO_MANAGER'&#xA;&#xA;UPDATE #EMPLOYEES&#xA;SET internal_id_SVP = 'leave'&#xA;,PROCESSED_SVP = 1&#xA;WHERE EmployeeStatus IN ('LTI','leave') and ISNULL(internal_id_SVP,'NO_MANAGER') = 'NO_MANAGER' &#xA;&#xA;select @COUNT = COUNT(1)&#xA;from #EMPLOYEES&#xA;where PROCESSED_VP = 0&#xA; &#xA;WHILE @COUNT &gt; 0&#xA;BEGIN&#xA;UPDATE EMP&#xA;SET&#xA; EMP.internal_id_VP = CASE WHEN EMP.PROCESSED_VP = 1 THEN internal_id_VP&#xA;                                     WHEN CAST(round(CASE WHEN ISNUMERIC(DJOB.job_level) = 1 THEN DJOB.job_level ELSE '0' END,0) as int) &gt;= 10 THEN  DJOB.Internal_id&#xA;                                     ELSE ISNULL(DJOB.manager_id,'NO_MANAGER')&#xA;                                    END&#xA;&#xA;,EMP.PROCESSED_VP = CASE WHEN CAST(round(CASE WHEN ISNUMERIC(job_level) = 1 THEN job_level ELSE '0' END,0) as int) &gt;= 10 THEN 1&#xA;                                          WHEN ISNULL(DJOB.manager_id,'NO_MANAGER') = 'NO_MANAGER' THEN 1&#xA;                                          ELSE 0&#xA;                                  END&#xA;FROM #EMPLOYEES EMP&#xA;LEFT JOIN [HRStage].[dbo].[GHRD5003_EXT_jobinformation] (NOLOCK) DJOB&#xA;ON DJOB.userid = EMP.internal_id_VP&#xA;--AND DJOB.internal_id = DJOB.userid&#xA;AND DJOB.Effective_start_date &lt;= CAST(GETDATE() as DATE)&#xA;AND DJOB.Effective_end_date &gt;= CAST(GETDATE() as DATE)&#xA;AND NOT EXISTS (select 1 from [HRStage].[dbo].[GHRD5003_EXT_jobinformation]  (NOLOCK) DJOB2 &#xA;                           where DJOB.userid = DJOB2.userid&#xA;                           --AND DJOB2.internal_id = DJOB2.userid&#xA;                           AND DJOB2.Effective_start_date &lt;= CAST(GETDATE() as DATE)&#xA;                           AND DJOB2.Effective_end_date &gt;= CAST(GETDATE() as DATE)&#xA;                           AND DJOB2.Effective_start_date &lt; DJOB.Effective_start_date&#xA;                           )&#xA;WHERE&#xA;EMP.PROCESSED_VP = 0 &#xA;&#xA;select @COUNT = COUNT(1)&#xA;from #EMPLOYEES EMP&#xA;WHERE EMP.PROCESSED_VP = 0&#xA;END&#xA;&#xA;select @COUNT = COUNT(1)&#xA;from #EMPLOYEES&#xA;where PROCESSED_SVP = 0 &#xA;&#xA;WHILE @COUNT &gt; 0&#xA;BEGIN&#xA;UPDATE EMP&#xA;SET&#xA; EMP.internal_id_SVP = CASE WHEN EMP.PROCESSED_SVP = 1 THEN internal_id_SVP&#xA;                                     WHEN CAST(round(CASE WHEN ISNUMERIC(DJOB.job_level) = 1 THEN DJOB.job_level ELSE '0' END,0) as int) &gt;= 11 THEN  DJOB.Internal_id&#xA;                                     ELSE ISNULL(DJOB.manager_id,'NO_MANAGER')&#xA;                                    END&#xA;&#xA;,EMP.PROCESSED_SVP = CASE WHEN CAST(round(CASE WHEN ISNUMERIC(job_level) = 1 THEN job_level ELSE '0' END,0) as int) &gt;= 11 THEN 1&#xA;                                          WHEN ISNULL(DJOB.manager_id,'NO_MANAGER') = 'NO_MANAGER' THEN 1&#xA;                                          ELSE 0&#xA;                                   END&#xA;&#xA;FROM #EMPLOYEES EMP&#xA;LEFT JOIN [HRStage].[dbo].[GHRD5003_EXT_jobinformation] (NOLOCK) DJOB&#xA;ON DJOB.userid = EMP.internal_id_SVP&#xA;--AND DJOB.internal_id = DJOB.userid&#xA;AND DJOB.Effective_start_date &lt;= CAST(GETDATE() as DATE)&#xA;AND DJOB.Effective_end_date &gt;= CAST(GETDATE() as DATE)&#xA;AND NOT EXISTS (select 1 from [HRStage].[dbo].[GHRD5003_EXT_jobinformation]  (NOLOCK) DJOB2 &#xA;                           where DJOB.userid = DJOB2.userid&#xA;                           --AND DJOB2.internal_id = DJOB2.userid&#xA;                           AND DJOB2.Effective_start_date &lt;= CAST(GETDATE() as DATE)&#xA;                           AND DJOB2.Effective_end_date &gt;= CAST(GETDATE() as DATE)&#xA;                           AND DJOB2.Effective_start_date &lt; DJOB.Effective_start_date)&#xA;WHERE&#xA;EMP.PROCESSED_SVP = 0 &#xA;&#xA;select @COUNT = COUNT(1)&#xA;from #EMPLOYEES EMP&#xA;WHERE&#xA;EMP.PROCESSED_SVP = 0&#xA;END&#xA;&#xA;UPDATE #EMPLOYEES&#xA;SET internal_id_VP = 'leave'&#xA;WHERE EmployeeStatus IN ('LTI','leave') and ISNULL(internal_id_VP,'NO_MANAGER') = 'NO_MANAGER' &#xA;&#xA;UPDATE #EMPLOYEES&#xA;SET internal_id_SVP = 'leave'&#xA;WHERE EmployeeStatus IN ('LTI','leave') and ISNULL(internal_id_SVP,'NO_MANAGER') = 'NO_MANAGER' &#xA;&#xA;UPDATE ACH_OUT&#xA;set ACH_OUT.VP = CASE WHEN EMP.internal_id_VP = 'leave' THEN EMP.internal_id_VP ELSE DPER.first_name + ' ' + DPER.last_name END&#xA;from HR_PROCESSING.[dbo].[GHRD5003_AchieversOutput] ACH_OUT&#xA;INNER JOIN #EMPLOYEES EMP&#xA;ON EMP.EmployeeID = ACH_OUT.EmployeeID&#xA;LEFT JOIN [HRStage].[dbo].[GHRD5003_EXT_personalinfo] (NOLOCK) DPER&#xA;ON DPER.internal_id = EMP.internal_id_VP&#xA;AND DPER.Effective_start_date &lt;= CAST(GETDATE() as DATE)&#xA;AND DPER.Effective_end_date &gt;= CAST(GETDATE() as DATE)&#xA;WHERE ACH_OUT.Date_Loaded = @MAXDATE&#xA;&#xA;UPDATE ACH_OUT&#xA;set ACH_OUT.SVP = CASE WHEN EMP.internal_id_SVP = 'leave' THEN EMP.internal_id_SVP ELSE DPER.first_name + ' ' + DPER.last_name END&#xA;from HR_PROCESSING.[dbo].[GHRD5003_AchieversOutput] ACH_OUT&#xA;INNER JOIN #EMPLOYEES EMP&#xA;ON EMP.EmployeeID = ACH_OUT.EmployeeID&#xA;LEFT JOIN [HRStage].[dbo].[GHRD5003_EXT_personalinfo] (NOLOCK) DPER&#xA;ON DPER.internal_id = EMP.internal_id_SVP&#xA;AND DPER.Effective_start_date &lt;= CAST(GETDATE() as DATE)&#xA;AND DPER.Effective_end_date &gt;= CAST(GETDATE() as DATE)&#xA;WHERE ACH_OUT.Date_Loaded = @MAXDATE &#xA;&#xA;DROP TABLE #EMPLOYEES" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
                      </DTS:ObjectData>
                    </DTS:Executable>
