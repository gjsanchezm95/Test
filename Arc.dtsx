                                  description="Input to the Conditional Split Transformation"
                                  name="Conditional Split Input">
                                  <inputColumns>
                                    <inputColumn
                                      refId="Package\SC_RUN_PACKAGE\SC_TRANSFORMATION_PHASE\FL_TRANSFORMATION_LOAD_PHASE\SC_TRANSFORMATION_LOAD\DataGenerator\Businessunit.Inputs[Conditional Split Input].Columns[BusinessUnit_ISNULL]"
                                      cachedDataType="wstr"
                                      cachedLength="1"
