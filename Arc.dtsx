                <DTS:Executable
                  DTS:refId="Package\SC_RUN_PACKAGE\SC_TRANSFORMATION_PHASE\FL_TRANSFORMATION_LOAD_PHASE\SC_TRANSFORMATION_LOAD"
                  DTS:CreationName="STOCK:SEQUENCE"
                  DTS:Description="Sequence Container"
                  DTS:DTSID="{F0F6FC39-5F98-4829-B047-B3733CA8607D}"
                  DTS:ExecutableType="STOCK:SEQUENCE"
                  DTS:LocaleID="-1"
                  DTS:ObjectName="SC_TRANSFORMATION_LOAD">
                  <DTS:Variables />
                  <DTS:Executables>
                    <DTS:Executable
                      DTS:refId="Package\SC_RUN_PACKAGE\SC_TRANSFORMATION_PHASE\FL_TRANSFORMATION_LOAD_PHASE\SC_TRANSFORMATION_LOAD\AllReports &amp; Direct Reports"
                      DTS:CreationName="Microsoft.ExecuteSQLTask"
                      DTS:Description="Execute SQL Task"
                      DTS:DTSID="{31288C72-35DA-479C-AFD1-A5A96237B5BC}"
                      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
                      DTS:LocaleID="-1"
                      DTS:ObjectName="AllReports &amp; Direct Reports"
                      DTS:ThreadHint="0">
                      <DTS:Variables />
                      <DTS:ObjectData>
                        <SQLTask:SqlTaskData
                          SQLTask:Connection="{5E39721A-D791-4A6B-A333-E3322996906F}"
                          SQLTask:SqlStatementSource="USE HRSTAGE;&#xA;&#xA;DECLARE @COUNT Int;&#xA;DECLARE @MAXDATE as DATE;&#xA;DECLARE @sql NVARCHAR(MAX);&#xA;&#xA;set @COUNT = 11;&#xA;&#xA;CREATE TABLE #EmpManager (&#xA;&#x9;Emp_Employee_ID&#x9;&#x9;NVARCHAR(50) NULL,&#xA;&#x9;Emp_internal_id&#x9;&#x9;NVARCHAR(50) NULL,&#xA;&#x9;Emp_UserID&#x9;&#x9;&#x9;NVARCHAR(50) NULL,&#xA;&#x9;Emp_Scotia_ID&#x9;&#x9;NVARCHAR(50) NULL,&#xA;&#x9;Emp_EmplStatus&#x9;&#x9;NVARCHAR(50) NULL,&#xA;&#x9;Emp_Employee_Type&#x9;NVARCHAR(50) NULL,&#xA;&#x9;Mgr_UserID&#x9;&#x9;&#x9;NVARCHAR(50) NULL,&#xA;&#x9;Mgr_Scotia_ID&#x9;&#x9;NVARCHAR(50) NULL,&#xA;&#x9;Mgr_Internal_id&#x9;&#x9;NVARCHAR(50) NULL,&#xA;&#x9;Mgr_EmplStatus&#x9;&#x9;NVARCHAR(50) NULL,&#xA;&#x9;Mgr_Employee_Type&#x9;NVARCHAR(50) NULL,&#xA;&#x9;Mgr_Executive_Level&#x9;NVARCHAR(50) NULL&#xA;&#x9;);&#xA;&#xA;INSERT INTO #EmpManager (Emp_Employee_ID,Emp_internal_id, Emp_UserID, Emp_Scotia_ID, Emp_EmplStatus, Emp_Employee_Type, Mgr_UserID, Mgr_Scotia_ID,Mgr_Internal_id, Mgr_EmplStatus, Mgr_Employee_Type, Mgr_Executive_Level) &#xA;SELECT bio.Employee_ID,bio.Internal_ID, job.UserID, bio.Scotia_ID, job.EmplStatus, job.Employee_Type, job.Manager_ID, mbio.Scotia_ID,mbio.internal_id,mjob.EmplStatus, mjob.Employee_Type, mjob.Executive_Level&#xA;FROM HRSTAGE.[dbo].[GHRD5003_EXT_bioinformation] (NOLOCK) bio&#xA;INNER JOIN HRSTAGE.[dbo].[GHRD5003_EXT_jobinformation] (NOLOCK) job ON bio.Internal_id = job.Internal_id AND job.Effective_Start_Date &lt;= CAST(GETDATE() AS DATE) AND job.effective_end_date &gt;= CAST(GETDATE() AS DATE) --AND job.Internal_ID = job.UserID&#xA;INNER JOIN (SELECT maxSeq.Internal_ID, maxSeq.UserID, max(maxSeq.seq_number) maxSeqNumber&#xA;&#x9;&#x9;&#x9;FROM HRSTAGE.[dbo].[GHRD5003_EXT_jobinformation] (NOLOCK) maxSeq &#xA;&#x9;&#x9;&#x9;WHERE maxSeq.effective_start_Date &lt;= CAST(GETDATE() AS DATE) AND maxSeq.effective_end_Date &gt;= CAST(GETDATE() AS DATE)&#xA;&#x9;&#x9;&#x9;GROUP BY maxSeq.Internal_ID, maxSeq.USerID&#xA;&#x9;&#x9;&#x9;) job2 ON job2.Internal_ID = job.Internal_ID AND job2.UserID = job.UserID AND job2.maxSeqNumber = job.seq_number&#xA;INNER JOIN HRSTAGE.[dbo].[GHRD5003_EXT_jobinformation] (NOLOCK) mjob ON mjob.UserID = job.Manager_ID AND mjob.Effective_Start_Date &lt;= CAST(GETDATE() AS DATE) AND mjob.effective_end_date &gt;= CAST(GETDATE() AS DATE) &#xA;INNER JOIN (SELECT maxSeq.Internal_ID, maxSeq.UserID, max(maxSeq.seq_number) maxSeqNumber&#xA;&#x9;&#x9;&#x9;FROM HRSTAGE.[dbo].[GHRD5003_EXT_jobinformation] (NOLOCK) maxSeq &#xA;&#x9;&#x9;&#x9;WHERE maxSeq.effective_start_Date &lt;= CAST(GETDATE() AS DATE) AND maxSeq.effective_end_Date &gt;= CAST(GETDATE() AS DATE)&#xA;&#x9;&#x9;&#x9;GROUP BY maxSeq.Internal_ID, maxSeq.USerID&#xA;&#x9;&#x9;&#x9;) mjob2 ON mjob2.Internal_ID = mjob.Internal_ID AND mjob2.UserID = mjob.UserID AND mjob2.maxSeqNumber = mjob.seq_number&#xA;INNER JOIN  HRSTAGE.[dbo].[GHRD5003_EXT_bioinformation] (NOLOCK) mbio on mbio.Internal_ID = mjob.Internal_ID&#xA;LEFT OUTER JOIN HRSTAGE.[dbo].[GHRD5003_EXT_personalinfo] (NOLOCK) mpi ON mpi.Internal_ID = mbio.Internal_ID AND mpi.effective_start_date &lt;= CAST(GETDATE() AS DATE) AND mpi.effective_end_date &gt;= CAST(GETDATE() AS DATE) AND mpi.effective_start_date != mpi.effective_end_date&#xA;LEFT OUTER JOIN HRSTAGE.[dbo].[GHRD5003_EXT_globalassignmentinformation] (NOLOCK)  ga ON  ga.Internal_ID =  job.Internal_ID AND  ga.UserID =  job.UserID AND  ga.Start_Date &lt;= CAST(GETDATE() AS DATE) AND COALESCE( ga.End_Date,  ga.planned_end_date,'9999/12/31') &gt;= CAST(GETDATE() AS DATE)&#xA;LEFT OUTER JOIN HRSTAGE.[dbo].[GHRD5003_EXT_globalassignmentinformation] (NOLOCK) mga ON mga.Internal_ID = mjob.Internal_ID AND mga.UserID = mjob.UserID AND mga.Start_Date &lt;= CAST(GETDATE() AS DATE) AND COALESCE(mga.End_Date, mga.planned_end_date,'9999/12/31') &gt;= CAST(GETDATE() AS DATE)&#xA;WHERE bio.Employee_ID NOT IN ('test')&#xA;AND RTRIM(ISNULL(bio.Scotia_ID,'')) != ''&#xA;AND RTRIM(ISNULL(job.Manager_ID,'')) != ''&#xA;AND (   ( ga.Internal_ID IS NOT NULL AND  job.Internal_ID !=  job.UserID)&#x9;-- global assignee and this is the secondary assignment &#xA;&#x9; OR ( ga.Internal_ID IS NULL))--     AND  job.Internal_ID  =  job.UserID))&#x9;-- not a global assignee and this is the primary assignment&#xA;AND (   (mga.Internal_ID IS NOT NULL AND mjob.Internal_ID != mjob.UserID)&#x9;-- manager global assignee and this is the secondary assignment &#xA;&#x9; OR (mga.Internal_ID IS NULL))--     AND mjob.Internal_ID  = mjob.UserID))&#x9;-- manager not a global assignee and this is the primary assignment&#xA;AND job.EmplStatus IN ('A','U','P','D');&#xA;&#xA;&#xA;select&#xA;  em0.Emp_Employee_ID&#xA;, em0.Emp_Internal_ID AS Level0&#xA;, em0.Mgr_Internal_id AS Level1&#x9;  &#xA;, em1.Mgr_Internal_id AS Level2&#x9;  &#xA;, em2.Mgr_Internal_id AS Level3&#x9;  &#xA;, em3.Mgr_Internal_id AS Level4&#x9;  &#xA;, em4.Mgr_Internal_id AS Level5&#x9;  &#xA;, em5.Mgr_Internal_id AS Level6&#x9;  &#xA;, em6.Mgr_Internal_id AS Level7&#x9;  &#xA;, em7.Mgr_Internal_id AS Level8&#x9;  &#xA;, em8.Mgr_Internal_id AS Level9&#x9;  &#xA;, em9.Mgr_Internal_id AS Level10&#x9;  &#xA;, em10.Mgr_Internal_id AS Level11&#xA;,ISNULL(      em0.Emp_Internal_ID,'') + ISNULL('/' +  em0.Mgr_Internal_id,'') + ISNULL('/' + em1.Mgr_Internal_id,'') + ISNULL('/' + em2.Mgr_Internal_id,'') + ISNULL('/' + em3.Mgr_Internal_id,'') + &#xA;ISNULL('/' + em4.Mgr_Internal_id,'') + ISNULL('/' +  em5.Mgr_Internal_id,'') + ISNULL('/' + em6.Mgr_Internal_id,'') + ISNULL('/' + em7.Mgr_Internal_id,'') + ISNULL('/' + em8.Mgr_Internal_id,'') + &#xA;ISNULL('/' + em9.Mgr_Internal_id,'') + ISNULL('/' +  em10.Mgr_Internal_id,'') AS &quot;Path&quot;&#xA;INTO #MNGLEVELS&#xA;FROM #EmpManager em0&#xA;LEFT OUTER JOIN #EmpManager em1  ON  em1.Emp_UserID  = em0.Mgr_UserID&#xA;LEFT OUTER JOIN #EmpManager em2  ON  em2.Emp_UserID  = em1.Mgr_UserID&#xA;LEFT OUTER JOIN #EmpManager em3  ON  em3.Emp_UserID  = em2.Mgr_UserID&#xA;LEFT OUTER JOIN #EmpManager em4  ON  em4.Emp_UserID  = em3.Mgr_UserID&#xA;LEFT OUTER JOIN #EmpManager em5  ON  em5.Emp_UserID  = em4.Mgr_UserID&#xA;LEFT OUTER JOIN #EmpManager em6  ON  em6.Emp_UserID  = em5.Mgr_UserID&#xA;LEFT OUTER JOIN #EmpManager em7  ON  em7.Emp_UserID  = em6.Mgr_UserID&#xA;LEFT OUTER JOIN #EmpManager em8  ON  em8.Emp_UserID  = em7.Mgr_UserID&#xA;LEFT OUTER JOIN #EmpManager em9  ON  em9.Emp_UserID  = em8.Mgr_UserID&#xA;LEFT OUTER JOIN #EmpManager em10 ON em10.Emp_UserID  = em9.Mgr_UserID&#xA;WHERE em0.Emp_Scotia_ID IS NOT NULL&#xA;ORDER BY em0.Emp_Employee_ID;&#xA;&#xA;select @MAXDATE = MAX(Date_Loaded) FROM HR_PROCESSING.[dbo].[GHRD5003_AchieversOutput];&#xA;&#xA;select &#xA; A.EmployeeId&#xA;,DBIO.Internal_id&#xA;,0 as Direct_Report&#xA;,0 as ALL_Report&#xA;INTO #AREP_CALC&#xA;from HR_PROCESSING.[dbo].[GHRD5003_AchieversOutput] A&#xA;INNER JOIN [HRStage].[dbo].[GHRD5003_EXT_bioinformation] (NOLOCK) DBIO&#xA;ON A.EmployeeId = DBIO.employee_id&#xA;WHERE A.Date_Loaded = @MAXDATE;&#xA;&#xA;WHILE @COUNT &gt; 0&#xA;BEGIN&#xA;&#xA;&#x9;SET @sql = &#xA;&#x9;'UPDATE A&#xA;&#x9;set ALL_Report = ALL_Report + B.cnt&#xA;&#x9;FROM #AREP_CALC A&#xA;&#x9;INNER JOIN&#xA;&#x9;(&#xA;&#x9;select &#xA;&#x9; A.EmployeeId&#xA;&#x9;,count(distinct C.Level0) cnt&#xA;&#x9;from #AREP_CALC A&#xA;&#x9;INNER JOIN [HRStage].[dbo].[GHRD5003_EXT_bioinformation] B&#xA;&#x9;ON B.employee_id = A.employeeid&#xA;&#x9;LEFT JOIN #MNGLEVELS C&#xA;&#x9;ON C.Level' + CAST(@COUNT as NVARCHAR(2)) + ' = B.Internal_id&#xA;&#x9;group by A.EmployeeId&#xA;&#x9;) B&#xA;&#x9;ON B.EmployeeId = A.EmployeeId'&#xA;&#xA;&#x9;EXEC sp_executesql @sql&#xA;&#xA;&#x9;set @COUNT = @COUNT - 1&#xA;&#xA;END;&#xA;&#xA;&#xA;UPDATE A&#xA;set Direct_Report = B.cnt&#xA;FROM #AREP_CALC A&#xA;INNER JOIN&#xA;(&#xA;select &#xA; A.EmployeeId&#xA;,count(distinct C.Level0) cnt&#xA;from #AREP_CALC A&#xA;INNER JOIN [HRStage].[dbo].[GHRD5003_EXT_bioinformation] B&#xA;ON B.employee_id = A.employeeid&#xA;LEFT JOIN #MNGLEVELS C&#xA;ON C.Level1 = B.Internal_id&#xA;group by A.EmployeeId&#xA;) B&#xA;ON B.EmployeeId = A.EmployeeId;&#xA;&#xA;UPDATE A&#xA;SET A.Allreports= B.ALL_Report&#xA;,A.Directreports = B.Direct_Report&#xA;FROM HR_PROCESSING.[dbo].[GHRD5003_AchieversOutput] A&#xA;INNER JOIN #AREP_CALC B&#xA;ON B.EmployeeId = A.EmployeeId&#xA;WHERE A.Date_Loaded = @MAXDATE;&#xA;&#xA;DROP TABLE #EmpManager;&#xA;DROP TABLE #AREP_CALC;&#xA;DROP TABLE #MNGLEVELS;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
                      </DTS:ObjectData>
                    </DTS:Executable>
                    <DTS:Executable
                      DTS:refId="Package\SC_RUN_PACKAGE\SC_TRANSFORMATION_PHASE\FL_TRANSFORMATION_LOAD_PHASE\SC_TRANSFORMATION_LOAD\Clean Log"
                      DTS:CreationName="Microsoft.ExecuteSQLTask"
                      DTS:Description="Execute SQL Task"
                      DTS:DTSID="{B754F00A-D0EC-408F-8462-BED4CBAA0EDC}"
                      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
                      DTS:LocaleID="-1"
                      DTS:ObjectName="Clean Log"
                      DTS:ThreadHint="0">
                      <DTS:Variables />
                      <DTS:ObjectData>
                        <SQLTask:SqlTaskData
                          SQLTask:Connection="{5E39721A-D791-4A6B-A333-E3322996906F}"
                          SQLTask:SqlStatementSource="Select APP_SRCKEYFLD&#xA;into #LOGSTODEL&#xA;from [HR_Processing].[dbo].[GHRD5003_Exception_Log] &#xA;where APP_Procdt = CAST(Getdate() AS DATE)&#xA;AND APP_RULEVIOLATED like 'Original date of disability greater than 730%'&#xA;group by APP_SRCKEYFLD&#xA;&#xA;Delete&#xA;from [HR_Processing].[dbo].[GHRD5003_Exception_Log] &#xA;where APP_Procdt = CAST(Getdate() AS DATE)&#xA;AND APP_RULEVIOLATED not like 'Original date of disability greater than 730%'&#xA;AND APP_SRCKEYFLD&#xA;in&#xA;(&#xA;select APP_SRCKEYFLD from #LOGSTODEL&#xA;)&#xA;&#xA;Delete&#xA;from [HR_Processing].[dbo].[GHRD5003_Exception_Log] &#xA;where APP_Procdt = CAST(Getdate() AS DATE)&#xA;AND APP_RULEVIOLATED like 'Email Address is blank for employee%'&#xA;&#xA;DROP TABLE #LOGSTODEL" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
                      </DTS:ObjectData>
                    </DTS:Executable>
                    <DTS:Executable
                      DTS:refId="Package\SC_RUN_PACKAGE\SC_TRANSFORMATION_PHASE\FL_TRANSFORMATION_LOAD_PHASE\SC_TRANSFORMATION_LOAD\DataGenerator"
                      DTS:CreationName="Microsoft.Pipeline"
                      DTS:Description="Data Flow Task"
                      DTS:DTSID="{fad622c9-258b-444b-b389-5ddb6c1bec8c}"
