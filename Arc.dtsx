      ,[employee_class]
      ,[pay_grade]
      ,[regular_temp]
      ,[standard_hours]
      ,[workingDaysPerWeek]
      ,[fte]
      ,[is_fulltime_employee]
      ,[employee_type]
      ,[probation_period_end_date]
      ,[notes]
      ,[employment_type]
      ,[expected_return_date]
      ,[time_type_profile_code]
      ,[pay_scale_area]
      ,[pay_scale_type]
      ,[pay_scale_group]
      ,[pay_scale_level]
      ,[event_reason]
      ,[assignment_type]
      ,[assignment_end_date]
      ,[assignment_work_location]
      ,[union]
      ,[contract_end_date]
      ,[collective_bargaining_agreement]
      ,[is_shift_employee]
      ,[position_title]
      ,[legal_entity_standard_hours]
      ,[designation_flag]
      ,[enhanced_screening_indicator]
      ,[enhanced_screening_date_of_completion]
      ,[executive_level]
      ,[sensitive_position]
      ,[shift_type]
      ,[vacation_entitlement_override]
      ,[work_schedule_id]
      ,[job_family]
      ,[job_role]
      ,[eligible_for_overtime]
      ,[administered_level]
      ,[administered_level_end_date]
      ,[sub_billing]
      ,[country_object]
      ,[agreement_type]
      ,[acting_level]
      ,[job_level]
      ,[twelve_hour_shift]
      ,[effective_start_date]
      ,[effective_end_date]
      ,[flexible_work_arrangement]
      ,[CRA_entities]
      ,[CMO_flag]
      ,[is_union_delegate]
      ,[badge_id]
      ,[professional_flag]
      ,[workers_comp_code]
      ,[flexi_time_flag]
      ,[CostCenterExternalID]
      ,[Internal_id]
      ,[UserId]
      ,[Pay_Range]
      ,[FinanceLegalEntity]
      ,[Address_1]
      ,[Address_2]
      ,[City]
      ,[State]
      ,[ZIP]
      ,[Country]
      ,[seq_number]
      ,[EEO1_code_usa]
      ,[EEO_EthnicityCategory]
      ,[legal_hold]
      ,[updated_timestamp]
      ,[WFS_LOA]
      ,[holiday_calendar_code]
      ,[time_recording_variant]
      ,[workschedule_code]
      ,[Local_Material_Risk_Taker]
  FROM [dbo].[EC_D_demographic_jobinformation] A (NOLOCK)
  WHERE CASE WHEN A.effective_start_date = A.effective_end_date
		  and exists (select 1 from HCM.dbo.EC_D_Demographic_jobinformation B (NOLOCK)
					  where A.internal_id = B.internal_id 
					  and A.userid = B.userid
					  and A.effective_start_date = B.effective_start_date
			          and B.effective_end_date &gt; A.effective_end_date
			         )
		  and A.[event_reason] not like 'LV%'
		  and A.[event_reason] not like 'RH%'
		  and A.[event_reason] not like 'T_%'
		  and A.[event_reason] not like 'H_%'		  
		  THEN 0
		  ELSE 1
  END = 1</property>
