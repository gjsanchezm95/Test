              DTS:DTSID="{BD486921-E593-4B8E-842C-C20F69045EA9}"
              DTS:EvalExpression="@Ext_Count &lt;=3"
              DTS:ExecutableType="STOCK:FORLOOP"
              DTS:InitExpression="@Ext_Count = 1"
              DTS:LocaleID="-1"
              DTS:MaxConcurrent="1"
              DTS:ObjectName="FL_TRANSFORMATION_LOAD_PHASE">
              <DTS:Variables />
              <DTS:Executables>
                <DTS:Executable
                  DTS:refId="Package\SC_RUN_PACKAGE\SC_TRANSFORMATION_PHASE\FL_TRANSFORMATION_LOAD_PHASE\ET_Exit_Loop"
                  DTS:CreationName="Microsoft.ExpressionTask"
                  DTS:Description="Expression Task"
                  DTS:DTSID="{C3404C7C-DC0F-4B0C-B9CD-9692F2BF2D54}"
                  DTS:ExecutableType="Microsoft.ExpressionTask"
                  DTS:LocaleID="-1"
                  DTS:ObjectName="ET_Exit_Loop"
                  DTS:TaskContact="Expression Task;Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
