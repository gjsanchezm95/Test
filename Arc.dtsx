          <DTS:Variables />
          <DTS:Executables>
            <DTS:Executable
              DTS:refId="Package\SC_RUN_PACKAGE\SC_TRANSFORMATION_PHASE\FL_TRANSFORMATION_LOAD_PHASE"
              DTS:AssignExpression="@Ext_Count = @Ext_Count + 1"
              DTS:CreationName="STOCK:FORLOOP"
