                            <property
                              dataType="System.String"
                              description="The SQL command to be executed."
                              name="SqlCommand"
                              UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">USE HCM

SELECT [action]
      ,[position]
      ,[positionEntryDate]
      ,[emplStatus]
      ,[company]
      ,[business_unit]
      ,[division]
      ,[department]
      ,[location]
      ,[timezone]
      ,[cost_center]
      ,[manager_id]
      ,[job_code]
