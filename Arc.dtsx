            DateTime now = DateTime.Now;
            while (DateTime.Now.Subtract(now).Minutes < 5)
            {
                // wait for 60 seconds
            }

            Dts.TaskResult = (int)ScriptResults.Success;
		}

        #region ScriptResults declaration
